data/
datasets/
*.csv
*.json
*.parquet
*.pkl
*.db
*.sqlite*

# Notebooks y experimentación
.ipynb_checkpoints/
notebooks/experimentacion/
notebooks/pruebas_temp/
*.ipynb_checkpoints

# IDE y OS
.vscode/
.idea/
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Docker
.dockerignore
Dockerfile
docker-compose.yml
docker-compose.*.yml

# Logs y temporales
*.log
*.tmp
tmp/
temp/

# Documentos
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.md
